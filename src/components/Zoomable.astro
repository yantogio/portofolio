---
/**
 * Bungkus gambar agar bisa diklik dan dibuka besar di Lightbox.
 * Pemakaian: <Zoomable src={foto} alt="..."><Image src={foto} ... /></Zoomable>
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { getLang, t } from '@/i18n';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
}
const { src, alt, class: cls } = Astro.props;
const lang = getLang(Astro.url);
// Versi besar untuk lightbox (maks. 2400 px, webp); file asli untuk "Buka ukuran asli".
const large = await getImage({ src, width: Math.min(src.width, 2400), format: 'webp' });
---
<a
  href={large.src}
  data-lightbox
  data-original={src.src}
  data-caption={alt}
  class:list={['group/zoom relative block cursor-zoom-in', cls]}
  aria-label={`${t(lang, 'lightbox.zoom')}: ${alt}`}
>
  <slot />
  <span
    class="pointer-events-none absolute right-4 top-4 flex size-10 items-center justify-center rounded-full bg-bg/80 text-fg opacity-0 backdrop-blur-sm transition-opacity duration-300 group-hover/zoom:opacity-100 group-focus-visible/zoom:opacity-100"
    aria-hidden="true"
  >
    <Icon name="magnifying-glass-plus" />
  </span>
</a>
