---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Zoomable from '@/components/Zoomable.astro';
import { t } from '@/i18n';
import type { Lang } from '@/config/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;

const entries = (await getCollection('build-log'))
  .filter((e) => e.id.endsWith(`.${lang}`))
  .sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(entries.map(async (e) => ({ entry: e, Content: (await render(e)).Content })));

const intro = {
  id: 'Situs ini dibangun dengan cara yang sama seperti project saya yang lain: spec ditulis dulu, AI membantu membangun, lalu hasilnya diverifikasi dan diaudit. Ini catatannya.',
  en: 'This site was built the same way as my other projects: the spec came first, AI helped build it, and the result was verified and audited. These are the notes.',
}[lang];
---
<BaseLayout title={t(lang, 'buildlog.title')} description={t(lang, 'buildlog.description')}>
  <header class="wrap pb-12 pt-32 md:pt-40">
    <h1 class="display enter max-w-[16ch]" style="--i:0">{t(lang, 'buildlog.title')}</h1>
    <p class="enter mt-6 max-w-[58ch] text-lg text-fg-2 md:text-xl" style="--i:1">{intro}</p>
  </header>

  <ol class="wrap pb-24">
    {rendered.map(({ entry, Content }) => (
      <li class="reveal grid gap-6 border-t border-line py-12 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="font-mono text-sm text-accent">{entry.data.stage}</p>
          <h2 class="mt-2 text-3xl font-bold leading-tight tracking-tight">{entry.data.title}</h2>
        </div>
        <div class="lg:col-span-8">
          <div class="prose-case"><Content /></div>
          {entry.data.image && (
            <figure class="mt-8">
              <Zoomable src={entry.data.image} alt={entry.data.imageAlt ?? entry.data.title} class="overflow-hidden rounded-3xl border border-line">
                <Image src={entry.data.image} alt={entry.data.imageAlt ?? ''} widths={[640, 1000, 1400]} sizes="(min-width: 1024px) 60vw, 100vw" class="w-full" />
              </Zoomable>
              {entry.data.imageAlt && <figcaption class="mt-2 font-mono text-xs text-fg-2">{entry.data.imageAlt}</figcaption>}
            </figure>
          )}
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>
