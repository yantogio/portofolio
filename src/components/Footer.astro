---
import { getLang, localizePath, t } from '@/i18n';
import { profile } from '@/config/profile';

const lang = getLang(Astro.url);
const year = new Date().getFullYear();
---
<footer class="wrap">
  <div class="flex flex-col gap-4 border-t border-line py-8 text-sm text-fg-2 md:flex-row md:items-center md:justify-between">
    <p>© {year} {profile.fullName}</p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2">
      <li><a class="transition-colors hover:text-fg" href={localizePath('/how-i-built-this', lang)}>{t(lang, 'footer.buildLog')}</a></li>
      <li><a class="transition-colors hover:text-fg" href={profile.contact.github} rel="noopener noreferrer" target="_blank">GitHub<span class="sr-only"> {t(lang, 'project.external')}</span></a></li>
      <li><a class="transition-colors hover:text-fg" href={profile.contact.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn<span class="sr-only"> {t(lang, 'project.external')}</span></a></li>
    </ul>
  </div>
</footer>
