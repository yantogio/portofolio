---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---
<BaseLayout title="404">
  <section class="wrap grid gap-16 pb-20 pt-36 md:grid-cols-2 md:pb-32 md:pt-44">
    <div lang="id">
      <p class="font-mono text-6xl font-bold text-accent md:text-8xl">404</p>
      <h1 class="mt-6 text-3xl font-bold tracking-tight">Halaman tidak ditemukan</h1>
      <p class="mt-3 text-fg-2">Alamat ini tidak ada. Mungkin tautannya sudah berubah.</p>
      <a href="/" class="btn btn-primary group mt-8"><Icon name="arrow-left" />Kembali ke beranda</a>
    </div>
    <div lang="en" class="md:border-l md:border-line md:pl-16">
      <p class="font-mono text-6xl font-bold text-fg-2 md:text-8xl" aria-hidden="true">404</p>
      <h2 class="mt-6 text-3xl font-bold tracking-tight">Page not found</h2>
      <p class="mt-3 text-fg-2">This address does not exist. The link may have changed.</p>
      <a href="/en" class="btn btn-ghost group mt-8"><Icon name="arrow-left" />Back to Home</a>
    </div>
  </section>
</BaseLayout>
